# =====================================================================
# P8D E2E Test Configuration
# Copy this file to `.env` and override values for your environment.
# =====================================================================

# Environment: local | dev | staging | prod | ci | web
TEST_ENV=local

# ----- Tauri (desktop) -----
# Absolute path to the compiled P8D binary. tauri-driver launches this.
TAURI_APP_PATH=D:\\Project\\P8D\\P8D\\src-tauri\\target\\release\\volt-pos.exe
TAURI_DRIVER_PATH=tauri-driver
TAURI_DRIVER_HOST=127.0.0.1
TAURI_DRIVER_PORT=4444
# Optional — explicit path to msedgedriver.exe so we don't depend on PATH.
# Leave empty to rely on PATH.
MSEDGEDRIVER_PATH=C:\\WebDriver\\msedgedriver.exe

# ----- Web (browser) -----
# Used for `wdio.web.conf.ts` to test the frontend in a real browser.
WEB_BASE_URL=http://localhost:1420
WEB_BROWSER=chrome
HEADLESS=false

# ----- Android (real device via adb/Appium) -----
# `adb devices` must list the device/emulator before running `npm run test:android`.
ANDROID_APP_PACKAGE=com.fastboy.volt_pos.debug
ANDROID_APP_ACTIVITY=.MainActivity
# Absolute path to the debug APK to install (leave empty to use whatever is already installed).
ANDROID_APP_PATH=D:\\Project\\P8D\\P8D\\src-tauri\\gen\\android\\app\\build\\outputs\\apk\\universal\\debug\\app-universal-debug.apk
ANDROID_DEVICE_NAME=
ANDROID_UDID=
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
# Device->host localhost bridges the WebView needs for backend data. The app
# on the emulator calls localhost:<port>, which only reaches the laptop's dev
# server + backend while these adb-reverse forwards are live (mirrors
# `npm run android:reverse`). The test run re-establishes these every session
# so a dropped forward no longer shows "Couldn't load / check your connection"
# while the laptop is online. Comma-separated. Default: 1420,1421
ANDROID_REVERSE_PORTS=1420,1421

# ----- API backend -----
API_BASE_URL=http://localhost:8080
API_TOKEN=

# ----- Test accounts -----
TEST_USER_EMAIL=qa.user@p8d.local
TEST_USER_PIN=1234
TEST_ADMIN_EMAIL=qa.admin@p8d.local
TEST_ADMIN_PIN=9999
# Real staff token to enable the happy-path staff-token login test
# (src/specs/android/staff-token-login.e2e.ts). Leave empty to skip that case.
STAFF_TOKEN=

# ----- Reporting -----
ALLURE_RESULTS_DIR=./reports/allure-results
LOG_LEVEL=info
SCREENSHOTS_ON_FAILURE=true

# ----- Timeouts (ms) -----
WAIT_TIMEOUT=15000
NAVIGATION_TIMEOUT=30000
LONG_TIMEOUT=60000

# ----- Misc -----
RETRY_FAILED_TESTS=1
PARALLEL_INSTANCES=1
